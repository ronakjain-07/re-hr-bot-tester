{
  "name": "PRAN Number Validation — User Enters Invalid PRAN, Then Corrects",
  "groupId": "national_pension_scheme",
  "goal": "User enters invalid PRAN (not 12 digits), bot rejects and re-prompts until valid PRAN is entered.",
  "constraints": "First PRAN is invalid; second is valid.",
  "tags": [
    "pran_validation",
    "edge_case",
    "input_retry"
  ],
  "testdata": {
    "employee_name": "Deepika Joshi",
    "employee_id": "RE22222",
    "position_title": "HR Executive",
    "employee_email": "deepika.joshi@royalenfield.com",
    "pranNumber_invalid": "12345",
    "pranNumber_valid": "123456789012",
    "pranProofFile": "pran_proof.pdf",
    "pranProofSizeMB": 1.5,
    "taxRegime": "New Regime",
    "npsContributionNew": 10
  },
  "phases": [
    {
      "id": "intro",
      "description": "User selects 'Proceed'.",
      "completionCriteria": "Bot displays employee details confirmation.",
      "maxAttempts": 1
    },
    {
      "id": "employee_details",
      "description": "User confirms details.",
      "completionCriteria": "Bot asks about PRAN availability.",
      "maxAttempts": 1
    },
    {
      "id": "pran_availability",
      "description": "User says 'Yes'.",
      "completionCriteria": "Bot prompts for PRAN number.",
      "maxAttempts": 1
    },
    {
      "id": "pran_number_invalid",
      "description": "User enters invalid PRAN (e.g., '12345').",
