      "maxAttempts": 1
    },
    {
      "id": "pran_number_valid",
      "description": "User enters valid PRAN.",
      "completionCriteria": "Bot prompts for PRAN proof upload.",
      "maxAttempts": 1
    },
    {
      "id": "pran_proof",
      "description": "User uploads valid PDF proof.",
      "completionCriteria": "Bot prompts for Opt-In/Opt-Out.",
      "maxAttempts": 1
    },
    {
      "id": "opt_selection",
      "description": "User selects 'Opt IN for NPS'.",
      "completionCriteria": "Bot prompts for tax regime.",
      "maxAttempts": 1
    },
    {
      "id": "tax_regime_and_contribution",
      "description": "User selects 'New Regime' and enters 10 as contribution.",
      "completionCriteria": "Bot submits update and displays completion message.",
      "maxAttempts": 2
    }
  ],
  "limits": {
    "maxTotalTurns": 25,
