{
  "name": "Edge Case — Invalid Mobile Number, Corrected",
  "groupId": "annual_health_checkup_employee",
  "goal": "User enters an invalid mobile number first, then corrects it to a valid number.",
  "constraints": "First mobile input fails validation, user provides valid number on second attempt.",
  "tags": [
    "edge",
    "validation",
    "mobile_number"
  ],
  "testdata": {
    "eligibilityValidity": {
      "result": {
        "mode": "book",
        "message": "You are eligible to book your annual health checkup."
      }
    },
    "coverageType": "Employee Only",
    "appointmentDatestr": "{{today+7}}",
    "emp_mobile_raw_attempt1": "1234567890",
    "emp_mobile_raw_attempt2": "9876543210",
    "state": "Maharashtra",
    "city": "Mumbai",
    "clinicName": "Fortis Hospital, Mulund"
  },
  "phases": [
    {
      "id": "phase_1",
      "description": "Eligibility and booking intent.",
      "completionCriteria": "User selects 'Book an appointment'.",
      "maxAttempts": 1
    },
    {
      "id": "phase_2",
      "description": "Coverage type selection.",
      "completionCriteria": "User selects 'Employee Only'.",
      "maxAttempts": 1
    },
    {
      "id": "phase_3",
      "description": "Appointment date collection and validation.",
      "completionCriteria": "User provides valid appointment date.",
      "maxAttempts": 1
    },
    {
      "id": "phase_4",
      "description": "Invalid then valid mobile number entry.",
      "completionCriteria": "Bot rejects first mobile, accepts second valid mobile.",
      "maxAttempts": 2
    },
    {
      "id": "phase_5",
      "description": "State, city, and clinic selection.",
      "completionCriteria": "User selects valid state, city, and clinic.",
      "maxAttempts": 1
    },
    {
      "id": "phase_6",
      "description": "Booking confirmation.",
      "completionCriteria": "Bot confirms booking and thanks user.",
      "maxAttempts": 1
    }
  ],
  "limits": {
    "maxTotalTurns": 25,
    "maxLlmCalls": 45
  },
  "manualPrereqs": [
    "Chrome must be open and logged into Google Chat as the test user"
  ],
  "schemaVersion": 1
}