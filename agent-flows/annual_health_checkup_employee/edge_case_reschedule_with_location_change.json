{
  "name": "Edge Case — Reschedule With Location Change",
  "groupId": "annual_health_checkup_employee",
  "goal": "User reschedules appointment and opts to change location.",
  "constraints": "User selects to change location, provides new state and city, then selects clinic.",
  "tags": [
    "edge",
    "reschedule",
    "location_change"
  ],
  "testdata": {
    "eligibilityValidity": {
      "result": {
        "mode": "manage",
        "message": "You already have a booking."
      }
    },
    "status2": "Reschedule the appointment",
    "appointmentDatestr": "{{today+7}}",
    "change_location": "Yes",
    "state": "Kerala",
    "city": "Kochi",
    "clinicName": "Aster Medcity, Kochi"
  },
  "phases": [
    {
      "id": "phase_1",
      "description": "Eligibility and reschedule intent.",
      "completionCriteria": "User selects 'Reschedule the appointment'.",
      "maxAttempts": 1
    },
    {
      "id": "phase_2",
      "description": "New appointment date collection and validation.",
      "completionCriteria": "User provides valid new appointment date.",
      "maxAttempts": 1
    },
    {
      "id": "phase_3",
      "description": "Location change decision.",
      "completionCriteria": "User opts to change location.",
      "maxAttempts": 1
    },
    {
      "id": "phase_4",
      "description": "State, city, and clinic selection.",
      "completionCriteria": "User provides valid state, city, and selects clinic.",
      "maxAttempts": 2
    },
    {
      "id": "phase_5",
      "description": "Reschedule confirmation.",
      "completionCriteria": "Bot confirms appointment rescheduled and offers further assistance.",
      "maxAttempts": 1
    }
  ],
  "limits": {
    "maxTotalTurns": 20,
    "maxLlmCalls": 40
  },
  "manualPrereqs": [
    "Chrome must be open and logged into Google Chat as the test user"
  ],
  "schemaVersion": 1
}