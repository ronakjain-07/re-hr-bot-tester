{
  "name": "hr-bot-happy-flow-runner",
  "version": "1.0.0",
  "description": "Automated happy flow runner for HR Agentic Bot via Google Chat",
  "main": "runner.js",
  "scripts": {
    "run": "node runner.js",
    "run:all": "node runner.js --all",
    "agent": "node runnerAgent.js",
    "agent:all": "node runnerAgent.js --all",
    "report:regen": "node scripts/rebuildReports.js",
    "ui": "node server.js",
    "generate-specs": "node scripts/generateAgentSpecs.js",
    "install-browser": "npx playwright install chromium"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "playwright": "^1.44.0"
  }
}
