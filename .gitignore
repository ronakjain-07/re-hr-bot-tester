.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# ── Environment variables ─────────────────────────────────────
.env
.env.local
.env.*.local

# ── Agent runner resume checkpoint (local only) ─────────────
bot-runner/.hr-suite-checkpoint-agent.json
# agent-flows/ is intentionally tracked.

